# Copy this file to `keystore.properties` next to it and fill in your values.
# `keystore.properties` is gitignored and ONLY used at `assembleRelease` /
# `bundleRelease` time.
#
# Generate an upload keystore with (one-time):
#   keytool -genkey -v -keystore upload-keystore.jks \
#           -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Then put the file somewhere stable (e.g. ../keystores/upload-keystore.jks)
# and point storeFile at it.

storeFile=upload-keystore.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
